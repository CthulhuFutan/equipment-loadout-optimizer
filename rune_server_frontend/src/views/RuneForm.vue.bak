<script setup lang="ts">
import { ref } from 'vue'
import { useRouter } from 'vue-router'
import { Plus } from '@element-plus/icons-vue'
import { ElMessage } from 'element-plus'
import { createRune } from '@/api/rune'
import { imageUpload } from '@/api/upload'
import { RUNE_SLOTS, RUNE_SET_TYPES, RUNE_QUALITIES, STAT_TYPES } from '@/utils/constants'

const router = useRouter()

// ---- 类型 ----
interface SubStatItem {
  statType: string
  statValue: number | null
  sortOrder: number
}

interface RuneFormData {
  imageUrl: string
  runeName: string
  slotNumber: number | null
  setType: string
  quality: string
  starRating: number
  levels: number
  mainStatType: string
  mainStatValue: number | null
  grindSortOrder: number | null
  subStats: SubStatItem[]
}

// ---- 表单 ----
const form = ref<RuneFormData>({
  imageUrl: '',
  runeName: '',
  slotNumber: null,
  setType: '',
  quality: '',
  starRating: 6,
  levels: 0,
  mainStatType: '',
  mainStatValue: null,
  grindSortOrder: null,
  subStats: [],
})

const submitting = ref(false)

// ---- 图片上传 ----
const pendingFile = ref<File | null>(null)
const fileInputRef = ref<HTMLInputElement>()

function triggerUpload() {
  fileInputRef.value?.click()
}

function onFileChange(e: Event) {
  const input = e.target as HTMLInputElement
  if (input.files && input.files[0]) {
    pendingFile.value = input.files[0]
  }
}

// ---- 副属性 ----
function addSubStat() {
  if (form.value.subStats.length >= 5) {
    ElMessage.warning('最多 5 条副属性（含额外词条）')
    return
  }
  // 自动分配 sortOrder：已有列表中的最大值 +1，默认从 1 开始
  const usedOrders = form.value.subStats.map(s => s.sortOrder)
  let nextOrder = 1
  while (usedOrders.includes(nextOrder)) nextOrder++
  form.value.subStats.push({ statType: '', statValue: null, sortOrder: nextOrder })
}

function removeSubStat(index: number) {
  form.value.subStats.splice(index, 1)
}

// ---- 提交 ----
async function submit() {
  if (!form.value.slotNumber) { ElMessage.warning('请选择槽位'); return }
  if (!form.value.setType) { ElMessage.warning('请选择符文类型'); return }
  if (!form.value.quality) { ElMessage.warning('请选择品质'); return }
  if (!form.value.mainStatType) { ElMessage.warning('请选择主属性类型'); return }

  submitting.value = true
  try {
    // 有图片先上传
    if (pendingFile.value) {
      const uploadRes = await imageUpload(pendingFile.value, 'rune')
      form.value.imageUrl = (uploadRes as any).data ?? ''
    }
    await createRune(form.value)
    ElMessage.success('符文添加成功')
    router.push('/runes')
  } catch {
    // 拦截器已提示
  } finally {
    submitting.value = false
  }
}
</script>

<template>
  <div style="max-width:700px;margin:0 auto">

    <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px">
      <h2 style="margin:0">添加符文</h2>
      <el-button @click="router.push('/runes')">返回列表</el-button>
    </div>

    <!-- ====== 图片上传 ====== -->
    <div style="display:flex;align-items:flex-start;gap:16px;margin-bottom:24px">
      <div @click="triggerUpload"
           style="width:100px;height:100px;border:2px dashed #dcdfe6;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0">
        <img v-if="form.imageUrl || pendingFile"
             :src="form.imageUrl || (pendingFile ? URL.createObjectURL(pendingFile) : '')"
             style="width:100%;height:100%;object-fit:contain;border-radius:6px" />
        <el-icon v-else :size="28" color="#c0c4cc"><Plus /></el-icon>
      </div>
      <input ref="fileInputRef" type="file" hidden accept="image/*" @change="onFileChange" />
      <div style="flex:1">
        <div style="margin-bottom:8px;color:#606266;font-size:13px">点击左侧框上传符文图片</div>
        <el-input v-model="form.imageUrl" placeholder="或手动输入图片 URL" size="small" />
      </div>
    </div>

    <!-- ====== 基本信息 ====== -->
    <h3 style="margin-bottom:12px">基本信息</h3>
    <div style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:24px">
      <el-select v-model="form.slotNumber" placeholder="槽位" style="width:160px">
        <el-option v-for="s in RUNE_SLOTS" :key="s.value" :label="s.label" :value="s.value" />
      </el-select>
      <el-select v-model="form.setType" placeholder="符文类型" style="width:160px">
        <el-option v-for="t in RUNE_SET_TYPES" :key="t.value" :label="t.label" :value="t.value" />
      </el-select>
      <el-select v-model="form.quality" placeholder="品质" style="width:160px">
        <el-option v-for="q in RUNE_QUALITIES" :key="q.value" :label="q.label" :value="q.value" />
      </el-select>
      <div style="display:flex;align-items:center;gap:4px">
        <span style="font-size:13px;color:#606266">星级</span>
        <el-input-number v-model="form.starRating" :min="1" :max="7" style="width:130px" />
      </div>
      <div style="display:flex;align-items:center;gap:4px">
        <span style="font-size:13px;color:#606266">等级</span>
        <el-input-number v-model="form.levels" :min="0" :max="15" style="width:130px" />
      </div>
    </div>

    <!-- ====== 主属性 ====== -->
    <h3 style="margin-bottom:12px">主属性</h3>
    <div style="display:flex;gap:12px;margin-bottom:24px">
      <el-select v-model="form.mainStatType" placeholder="属性类型" style="width:180px">
        <el-option v-for="s in STAT_TYPES" :key="s.value" :label="s.label" :value="s.value" />
      </el-select>
      <el-input-number v-model="form.mainStatValue" placeholder="数值" :min="0" style="width:160px" />
    </div>

    <!-- ====== 副属性（动态列表） ====== -->
    <h3 style="margin-bottom:12px">
      副属性
      <el-button size="small" @click="addSubStat" style="margin-left:12px">+ 添加</el-button>
    </h3>
    <div v-if="form.subStats.length === 0"
         style="color:#c0c4cc;font-size:13px;margin-bottom:16px">尚未添加副属性</div>
    <div v-for="(sub, i) in form.subStats" :key="i"
         style="display:flex;align-items:center;gap:10px;margin-bottom:10px;padding:8px 12px;background:#fafafa;border-radius:6px">
      <el-select v-model="sub.statType" placeholder="词条类型" style="width:170px">
        <el-option v-for="s in STAT_TYPES" :key="s.value" :label="s.label" :value="s.value" />
      </el-select>
      <el-input-number v-model="sub.statValue" placeholder="数值" :min="0" style="width:140px" />
      <div style="display:flex;align-items:center;gap:4px">
        <span style="font-size:12px;color:#909399">序号</span>
        <el-input-number v-model="sub.sortOrder" :min="0" :max="4" style="width:90px" />
        <span style="font-size:11px;color:#c0c4cc">0=额外</span>
      </div>
      <el-button size="small" type="danger" plain @click="removeSubStat(i)">删除</el-button>
    </div>

    <!-- ====== 研磨目标 ====== -->
    <h3 style="margin-bottom:12px">研磨目标</h3>
    <div style="margin-bottom:24px">
      <el-select v-model="form.grindSortOrder" placeholder="选择被研磨的词条 sortOrder" clearable style="width:260px">
        <el-option v-for="sub in form.subStats.filter(s => s.sortOrder !== 0)"
                   :key="sub.sortOrder"
                   :label="`词条${sub.sortOrder}：${sub.statType || '未设类型'}`"
                   :value="sub.sortOrder" />
      </el-select>
      <span style="font-size:12px;color:#c0c4cc;margin-left:8px">无匹配词条表示不研磨</span>
    </div>

    <!-- ====== 提交 ====== -->
    <div style="border-top:1px solid #ebeef5;padding-top:20px">
      <el-button type="primary" :loading="submitting" @click="submit" size="large">
        添加符文
      </el-button>
      <el-button @click="router.push('/runes')" size="large" style="margin-left:12px">取消</el-button>
    </div>

  </div>
</template>

<style scoped>
</style>
